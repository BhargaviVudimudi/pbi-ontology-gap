            "isKey": true
          },
          {
            "name": "CustomerName",
            "dataType": "string"
          },
          {
            "name": "SegmentCode",
            "dataType": "string"
          },
          {
            "name": "Country",
            "dataType": "string",
            "description": "ISO country of the billing address"
          },
          {
            "name": "_etl_hash",
            "dataType": "string",
            "isHidden": true
          }
        ]
      },
      {
        "name": "Product",
