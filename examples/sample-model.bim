            "name": "DateKey",
            "dataType": "dateTime",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64"
          },
          {
            "name": "MonthName",
            "dataType": "string"
          }
        ]
      },
      {
        "name": "Employee",
        "columns": [
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "isKey": true
          },
          {
            "name": "EmployeeName",
            "dataType": "string"
          },
          {
            "name": "ManagerKey",
            "dataType": "int64"
          },
          {
            "name": "RegionCode",
            "dataType": "string"
          }
        ]
      },
      {
        "name": "Sales",
        "columns": [
          {
            "name": "SalesKey",
            "dataType": "int64"
          },
          {
            "name": "CustomerKey",
            "dataType": "int64"
          },
          {
            "name": "ProductKey",
            "dataType": "int64"
          },
          {
            "name": "OrderDate",
            "dataType": "dateTime"
          },
          {
            "name": "ShipDate",
            "dataType": "dateTime"
          },
          {
            "name": "EmployeeKey",
            "dataType": "int64"
          },
          {
            "name": "Amount",
            "dataType": "decimal"
          },
          {
            "name": "Cost",
            "dataType": "decimal"
          },
          {
            "name": "Discount",
            "dataType": "decimal"
          },
          {
            "name": "OrderStatus",
            "dataType": "string"
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "CALCULATE ( SUM ( Sales[Amount] ), Sales[OrderStatus] = \"Confirmed\" )"
          },
          {
            "name": "Total Revenue",
            "expression": "CALCULATE(SUM(Sales[Amount]), Sales[OrderStatus] = \"Confirmed\")"
          },
          {
            "name": "Net Revenue",
            "description": "Revenue after discount, confirmed orders only, excluding discontinued lines.",
            "expression": "CALCULATE ( SUMX ( Sales, Sales[Amount] * ( 1 - Sales[Discount] ) ), Sales[OrderStatus] = \"Confirmed\", Product[DiscontinuedFlag] = 0 )"
          },
          {
            "name": "Cost of Sales",
            "expression": "CALCULATE ( SUM ( Sales[Cost] ), Sales[OrderStatus] IN { \"Confirmed\", \"Shipped\" } )"
          },
          {
            "name": "Gross Margin",
            "expression": "[Net Revenue] - [Cost of Sales]"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE ( [Gross Margin], [Net Revenue], 0 )"
          },
          {
            "name": "Margin Variance %",
            "expression": "DIVIDE ( SUM ( Sales[Amount] ) - SUM ( Sales[Cost] ), SUM ( Sales[Cost] ), 0 )"
          },
          {
            "name": "Shipped Revenue",
            "expression": "CALCULATE ( [Revenue], USERELATIONSHIP ( Sales[ShipDate], 'Date'[DateKey] ) )"
          },
          {
            "name": "FY24 Baseline",
            "expression": "CALCULATE ( [Revenue], 'Date'[DateKey] >= DATE ( 2024, 4, 1 ) )"
          },
          {
            "name": "Order Count",
            "expression": "DISTINCTCOUNT ( Sales[SalesKey] )"
          }
        ]
      },
      {
        "name": "Budget",
        "columns": [
          {
            "name": "SegmentCode",
            "dataType": "string"
          },
          {
            "name": "BudgetAmount",
            "dataType": "decimal"
          }
        ],
        "measures": [
          {
            "name": "Budget Amount",
            "expression": "SUM ( Budget[BudgetAmount] )"
          }
        ]
      },
      {
